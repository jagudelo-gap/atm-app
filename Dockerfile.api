# syntax=docker/dockerfile:1
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY AtmApp.sln ./
COPY src/Atm.Common/*.csproj src/Atm.Common/
COPY src/Atm.Users/*.csproj src/Atm.Users/
COPY src/Atm.Accounts/*.csproj src/Atm.Accounts/
COPY src/Atm.Transactions/*.csproj src/Atm.Transactions/
COPY src/Atm.Api/*.csproj src/Atm.Api/
RUN dotnet restore src/Atm.Api/Atm.Api.csproj
COPY src/ src/
RUN dotnet publish src/Atm.Api/Atm.Api.csproj -c Release --no-restore -o /out

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
# curl is used by the compose health check
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && apt-get clean \
    && mkdir /data \
    && chown app:app /data
WORKDIR /app
COPY --from=build /out .
ENV ASPNETCORE_URLS=http://+:8080 \
    ConnectionStrings__Atm="Data Source=/data/atm.db"
VOLUME /data
USER app
EXPOSE 8080
ENTRYPOINT ["dotnet", "Atm.Api.dll"]
